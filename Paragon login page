<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Login</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .app-container {
            background-color: #ffffff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 320px;
        }

        h2 {
            text-align: center;
            color: #333;
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 1.5rem;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
        }

        .form-group input:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 10px;
        }

        .btn-group button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            font-weight: bold;
            transition: opacity 0.2s;
        }

        .btn-group button:hover {
            opacity: 0.9;
        }

        .btn-login {
            background-color: #007bff;
            color: white;
        }

        .btn-reset {
            background-color: #6c757d;
            color: white;
        }

        #login-msg {
            margin-top: 15px;
            text-align: center;
            font-weight: bold;
            min-height: 20px;
            padding: 10px;
            border-radius: 6px;
            display: none;
        }

        .msg-success {
            display: block !important;
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .msg-error {
            display: block !important;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>

    <div class="app-container">
        <h2>Secure Login</h2>
        <form id="loginForm" onsubmit="handleLogin(event)">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" placeholder="Enter your username">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" placeholder="Enter your password">
            </div>
            <div class="btn-group">
                <button type="button" class="btn-reset" onclick="resetLogin()">Cancel</button>
                <button type="submit" class="btn-login">Login</button>
            </div>
            <div id="login-msg"></div>
        </form>
    </div>

    <script>
        function handleLogin(event) {
            event.preventDefault(); 

            const userField = document.getElementById('username').value.trim();
            const passField = document.getElementById('password').value.trim();
            const msgBox = document.getElementById('login-msg');

            msgBox.className = '';
            msgBox.textContent = '';

            if (userField === '' || passField === '') {
                showMsg('Error: All fields are required!', 'msg-error');
            } else if (userField.length < 3) {
                showMsg('Error: Username must be at least 3 characters.', 'msg-error');
            } else if (passField.length < 6) {
                showMsg('Error: Password must be at least 6 characters.', 'msg-error');
            } else {
                showMsg('Success: Login authenticated successfully!', 'msg-success');
            }
        }

        function resetLogin() {
            document.getElementById('loginForm').reset();
            const msgBox = document.getElementById('login-msg');
            msgBox.className = '';
            msgBox.textContent = '';
        }

        function showMsg(message, cssClass) {
            const msgBox = document.getElementById('login-msg');
            msgBox.textContent = message;
            msgBox.className = cssClass;
        }
    </script>
</body>
</html>
